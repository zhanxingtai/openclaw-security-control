{
  "id": "sst-security-control-openclaw",
  "name": "sst-security-control-openclaw",
  "version": "1.0.2",
  "description": "为 OpenClaw 提供运行安全检测、风险识别和高风险操作控制。支持本地独立运行，默认不注册、不联网、不上传安全数据。",
  "categories": [
    "security"
  ],
  "activation": {
    "onStartup": true
  },
  "uiHints": {
    "intervention.enabled": {
      "advanced": false
    },
    "intervention.mode": {
      "advanced": false
    },
    "intervention.failStrategy": {
      "advanced": false
    },
    "application.runtimeHooks.enabled": {
      "advanced": false
    },
    "application.runtimeHooks.networkEnabled": {
      "advanced": false
    },
    "system.enabled": {
      "advanced": false
    },
    "system.procfs.enabled": {
      "advanced": false
    },
    "assetMonitor.enabled": {
      "advanced": false
    },
    "collector.ndjsonPath": {
      "advanced": false
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "collector": {
        "type": "object",
        "additionalProperties": true
      },
      "application": {
        "type": "object",
        "additionalProperties": true
      },
      "network": {
        "type": "object",
        "additionalProperties": true
      },
      "system": {
        "type": "object",
        "additionalProperties": true
      },
      "intervention": {
        "type": "object",
        "additionalProperties": true
      },
      "assetMonitor": {
        "type": "object",
        "additionalProperties": true
      },
      "environment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hostId": {
            "type": "string"
          },
          "containerId": {
            "type": "string"
          },
          "podName": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          }
        }
      },
      "bootstrap": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
