#!/usr/bin/env bash
# 兜底防线：github-main 上的 commit 必须使用 GitHub noreply 身份，
# 防止内部邮箱被烧录进公开仓库历史。
#
# 安装（每个克隆点执行一次）：
#   git config core.hooksPath scripts/git-hooks
#
# 注意：git var 在 2.55+ 行为变更，这里用环境变量+config 回退读取身份，
# 与 git 的解析顺序一致（环境变量 > -c 参数 > config 文件）。
set -e

OSS_BRANCH="github-main"
OSS_EMAIL="17995374+hixss@users.noreply.github.com"

branch="$(git branch --show-current)"
if [ "$branch" = "$OSS_BRANCH" ]; then
  author="${GIT_AUTHOR_EMAIL:-$(git config user.email || true)}"
  committer="${GIT_COMMITTER_EMAIL:-$(git config user.email || true)}"
  if [ "$author" != "$OSS_EMAIL" ] || [ "$committer" != "$OSS_EMAIL" ]; then
    echo "[pre-commit] Refused: $OSS_BRANCH 要求身份 $OSS_EMAIL" >&2
    echo "[pre-commit]   current author=$author committer=$committer" >&2
    echo "[pre-commit]   请改用 scripts/oss-sync.sh 产出 OSS commit。" >&2
    exit 1
  fi
fi
